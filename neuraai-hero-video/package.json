{
  "name": "neuraai-hero-video",
  "version": "1.0.0",
  "private": true,
  "description": "10-second Remotion motion graphic for the NeuraAI homepage hero",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render NeuraHero out/neuraai-hero.mp4",
    "still": "remotion still NeuraHero out/still.png --frame=299",
    "typecheck": "tsc --noEmit",
    "split-headline": "node scripts/split-headline.mjs",
    "generate-audio": "node scripts/generate-audio.mjs"
  },
  "dependencies": {
    "@fontsource/onest": "^5.3.1",
    "@remotion/cli": "4.0.534",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
